# ==========================================================
# .gitignore 规则说明（详细见 GITIGNORE.md）
# ----------------------------------------------------------
# 匹配规则：
#   - 每行一条 pattern，空行和 # 注释行被忽略
#   - 不含 "/" 的 pattern（如 *.o）匹配任意层级同名文件/目录
#   - 含 "/" 的 pattern（如 DebugConfig/）按仓库根路径锚定
#   - 末尾 "/" 只匹配目录；"!" 开头为例外（取反）
#   - 已提交过的文件不受本文件影响，需 git rm --cached 清除
#
# 验证：
#   git check-ignore -v 路径/文件    # 查看哪条规则命中
#   git status --ignored             # 列出被忽略文件
# ==========================================================


# ==========================================================
# 交付物 / 机械模型
# ==========================================================
*.STEP
*.step
*.stp
*.zip
*.7z
*.rar

# ==========================================================
# 内部工作目录
# ==========================================================
.workbuddy/
.claude/
.vscode/

# ==========================================================
# Keil / MDK 本机设置
# ==========================================================
*.uvguix.*
*.uvguix
*.uvoptx
JLinkSettings.ini
*.scvd
*.dbgconf
DebugConfig/
Objects/
Listings/
*.o
*.d
*.crf
*.dep
*.lnp
*.lst
*.map
*.axf
*.htm
*.iex
*.__i
*.bak
*.log
*.log.lock
*.uvopt
*.uvgui.*
*.plg
*.jlink
*.obj
*.tmp
*.~*

# ==========================================================
# IAR（仅根目录输出目录，避免误伤源码里的 Debug/）
# ==========================================================
/Debug/
/Release/
*.eww
*.ewp

# ==========================================================
# STM32CubeIDE
# ==========================================================
.settings/
/.project
/.cproject

# ==========================================================
# 系统垃圾文件
# ==========================================================
Thumbs.db
desktop.ini
.DS_Store


